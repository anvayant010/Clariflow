# Copy to .env (never commit .env). Get values from https://app.gnani.ai/voice
GNANI_API_KEY_ID=
# Check docs.gnani.ai for any additional required headers/keys
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
# v3.0 voices (all speak mr/hi/en): Avinash, Shivani, Lakshmi, Kalpana, Shubham, Prakash, Devansh, Yashraj, Chetana, Vasudha, Riyaa, Tarika, Harshad
GNANI_TTS_VOICE=Shivani
# Optional, only if organisers permit a third-party LLM
# Optional second key (a teammate's own registration), used only when the first key runs out of credit
GNANI_API_KEY_ID_2=
EXTRACTOR_PROVIDER=deterministic
EXTRACTOR_API_KEY=
DATABASE_URL=sqlite:///./clariflow.db

# --- hosting (set these in the host's settings, not in a file) ---
# Where recordings and generated voice are stored (the mounted disk on a host). Default: ./data
# DATA_DIR=/data
# How many proxies sit in front of the server (a host's proxy = 1). 0 = none (local).
# TRUSTED_PROXY_HOPS=1
# Public-demo limits (the 5,000 programme credits are shared by everyone who opens the link)
# DAILY_STT_CAP=100
# DAILY_TTS_CAP=150
# SESSION_AUDIO_CAP=10
# SESSION_TTS_CAP=20
# IP_SESSIONS_PER_DAY=10
# IP_STT_PER_DAY=25
# IP_TTS_PER_DAY=40
